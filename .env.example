# Local services
SEARXNG_URL=http://localhost:8888
HARVESTER_HOST=127.0.0.1
HARVESTER_PORT=8765

# Optional outbound proxy for web requests
HARVESTER_PROXY_URL=http://127.0.0.1:7897

# Local AI review command
CODEX_COMMAND=codex
CODEX_MODEL=

# Local learned filter model
HARVESTER_ML_MODEL=models/filter_model.pt
ML_FILTER_MODEL=models/filter_model.pt
SEARCH_CARDS_DIR=search_cards

# Runtime defaults
PER_QUERY=8
MAX_PAGES=8
CRAWL_CONCURRENCY=3
MAX_IMAGE_DOWNLOADS=40
